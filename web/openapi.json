{
  "openapi": "3.1.0",
  "info": {
    "title": "VeilDesk encrypted buyer HTTP API",
    "version": "1.0.0",
    "description": "Operator-enrolled opaque transport. Encrypt and sign locally; authenticate returned payloads against pinned provider keys. HTTP acceptance is not sender verification, settlement proof or trade permission. Providers decrypt requests. Relay observes routing/timing. No wallet broadcast API."
  },
  "servers": [
    {
      "url": "https://veildesk-relay.onrender.com",
      "description": "Existing relay; access requires explicit operator enrollment. This contract does not grant public paid access."
    }
  ],
  "security": [
    {
      "enrollmentBearer": []
    }
  ],
  "paths": {
    "/v1/providers": {
      "get": {
        "operationId": "discoverEnrolledProviders",
        "description": "Returns only providers/capabilities visible to this enrolled principal. Compare both returned public keys with trusted out-of-band pins; discovery alone is not a trust root.",
        "responses": {
          "200": {
            "description": "Enrolled descriptors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "schema",
                    "providers"
                  ],
                  "properties": {
                    "schema": {
                      "const": "veildesk.providers.v1"
                    },
                    "providers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "encryptionKey",
                          "signingKey",
                          "capabilities"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "encryptionKey": {
                            "type": "string"
                          },
                          "signingKey": {
                            "type": "string"
                          },
                          "capabilities": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, fields, envelope, expiry or capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid enrollment token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Wrong principal role or private enrollment restriction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or other-buyer resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "408": {
            "description": "Body upload timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting retry or invalid job state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate or pending-job limit; rate limits include Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage or service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "operationId": "submitEncryptedJob",
        "description": "Client role only. Body <=16384 UTF-8 bytes. Envelope direction=request. New expiry must be future epoch milliseconds within 1 hour. Persist the entire prepared body before POST, then retry it unchanged: fresh randomized encryption with the same ID conflicts. Envelope validation here is structural only.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical retry returns current job, including completed/expired states",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "201": {
            "description": "New opaque job queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, fields, envelope, expiry or capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid enrollment token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Wrong principal role or private enrollment restriction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or other-buyer resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "408": {
            "description": "Body upload timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting retry or invalid job state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate or pending-job limit; rate limits include Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage or service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "operationId": "getEncryptedJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Buyer ownership is derived from bearer identity. Verify all routing fields against your stored submission. Authenticate/decrypt invoice, review and response envelopes locally. processing can include an invoice or payment review; there is no plaintext settlement status to trust.",
        "responses": {
          "200": {
            "description": "Metadata and available encrypted envelopes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, fields, envelope, expiry or capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid enrollment token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Wrong principal role or private enrollment restriction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or other-buyer resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "408": {
            "description": "Body upload timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting retry or invalid job state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate or pending-job limit; rate limits include Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage or service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}/payment": {
      "post": {
        "operationId": "submitEncryptedPaymentReference",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "References an already-authorized existing transaction. Never sends funds. Requires a pending paid job and invoice. Exact encrypted hint retries are idempotent; changed hints conflict. Hint includes signed request/invoice hashes and txid inside ciphertext.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "envelope"
                ],
                "properties": {
                  "envelope": {
                    "$ref": "#/components/schemas/Envelope"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reference queued; not settlement confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "state": {
                      "const": "evidence_submitted"
                    },
                    "executionAuthorized": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, fields, envelope, expiry or capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid enrollment token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Wrong principal role or private enrollment restriction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or other-buyer resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "408": {
            "description": "Body upload timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting retry or invalid job state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate or pending-job limit; rate limits include Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage or service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}/artifacts/{index}": {
      "get": {
        "operationId": "getEncryptedArtifactChunk",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            }
          }
        ],
        "description": "Only the owner of a completed job can retrieve its chunks. Use the authenticated manifest from the result, not an untrusted count. Verify every chunk signature/context/index and final SHA-256 digest before using the report.",
        "responses": {
          "200": {
            "description": "One encrypted response-direction chunk",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "envelope"
                  ],
                  "properties": {
                    "envelope": {
                      "$ref": "#/components/schemas/Envelope"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, fields, envelope, expiry or capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid enrollment token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Wrong principal role or private enrollment restriction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or other-buyer resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "408": {
            "description": "Body upload timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting retry or invalid job state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate or pending-job limit; rate limits include Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Storage or service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "enrollmentBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Operator-issued opaque token, not a Privy token. HTTPS only. No secrets in URLs."
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "id",
          "direction",
          "ephemeralPublicKey",
          "salt",
          "iv",
          "ciphertext"
        ],
        "properties": {
          "version": {
            "const": 1
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$"
          },
          "direction": {
            "enum": [
              "request",
              "response"
            ]
          },
          "ephemeralPublicKey": {
            "type": "string",
            "minLength": 88,
            "maxLength": 88,
            "contentEncoding": "base64",
            "description": "Canonical padded base64 encoding of 65 bytes. Public key is SEC1 uncompressed P-256 (first byte 0x04)."
          },
          "salt": {
            "type": "string",
            "minLength": 44,
            "maxLength": 44,
            "contentEncoding": "base64",
            "description": "Canonical padded base64 encoding of 32 bytes. Public key is SEC1 uncompressed P-256 (first byte 0x04)."
          },
          "iv": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "contentEncoding": "base64",
            "description": "Canonical padded base64 encoding of 12 bytes. Public key is SEC1 uncompressed P-256 (first byte 0x04)."
          },
          "ciphertext": {
            "type": "string",
            "minLength": 5484,
            "maxLength": 5484,
            "contentEncoding": "base64",
            "description": "Canonical padded base64 encoding of 4112 bytes. Public key is SEC1 uncompressed P-256 (first byte 0x04)."
          }
        }
      },
      "Submission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "capability",
          "expiresAt",
          "envelope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$"
          },
          "provider": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer",
            "description": "Unix milliseconds"
          },
          "envelope": {
            "$ref": "#/components/schemas/Envelope"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "capability",
          "state",
          "createdAt",
          "expiresAt",
          "late",
          "executionAuthorized"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "processing",
              "completed",
              "expired"
            ]
          },
          "createdAt": {
            "type": "integer"
          },
          "expiresAt": {
            "type": "integer"
          },
          "late": {
            "type": "boolean"
          },
          "executionAuthorized": {
            "const": false
          },
          "invoiceEnvelope": {
            "$ref": "#/components/schemas/Envelope"
          },
          "paymentReviewEnvelope": {
            "$ref": "#/components/schemas/Envelope"
          },
          "envelope": {
            "$ref": "#/components/schemas/Envelope"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
